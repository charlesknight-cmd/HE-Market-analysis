{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "streamlit",
        "run",
        "dashboard/app.py",
        "--server.headless",
        "true"
      ],
      "port": 8501
    },
    {
      "name": "charts",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "reports/preview"
      ],
      "port": 8765
    }
  ]
}
